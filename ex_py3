from copy import deepcopy

numbers = [7,2,5]

numbers.append(4)
print(numbers)

numbers.insert(1,10)
print(numbers)

numbers.extend([1,1,1])
print(numbers)

numbers.remove(7)
print(numbers)

numbers.pop(-1)
print(numbers)

numbers.sort()
print(numbers)

numbers.reverse()
print(numbers)
print(numbers.count(2))
print(numbers.index(1,1))

a = numbers.copy()
b = deepcopy(numbers)
numbers.clear()
print(numbers)
print(a)
print(b)
